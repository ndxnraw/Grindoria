{
  "name": "grindoria",
  "version": "0.30.0",
  "private": true,
  "description": "Grindoria — Definitely not Metin. Offline browser action RPG.",
  "author": {
    "name": "ndxnraw",
    "url": "https://github.com/ndxnraw"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ndxnraw/Grindoria.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node --test tests/*.test.*",
    "release": "node scripts/release.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "install-electron",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:verify": "node scripts/verify-desktop.mjs"
  },
  "productName": "Grindoria",
  "main": "desktop/main.cjs",
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  }
}
